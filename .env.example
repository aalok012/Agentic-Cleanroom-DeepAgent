# Copy to .env and edit — or let scripts/minsky/tunnel.sh generate it from a running job.
#
# Any OpenAI-compatible /v1 endpoint. Model ids are passed through verbatim, so use
# exactly what `curl $LLM_BASE_URL/models` reports.
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ
LLM_API_KEY=EMPTY

# Optional. Raises the deterministic stages off 0 for reasoning models that loop there
# (e.g. DeepSeek-R1 distills, which DeepSeek recommend running at ~0.6). The pass@k
# stage keeps its own sampling temperature either way.
# CLEANROOM_LLM_TEMPERATURE=0.6

# Optional: give the Dafny/proof stage a different model from the rest of the pipeline.
# LLM_DAFNY_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct-AWQ

# Optional: step budget for the deepagents repair driver (--repair-driver deepagent).
# One "step" is one agent turn or tool call; the budget is multiplied by the round count.
# CLEANROOM_DEEP_MAX_STEPS=60
